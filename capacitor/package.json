{
  "name": "spacehub-mobile",
  "version": "1.0.0",
  "description": "SpaceHub Mobile Application",
  "scripts": {
    "install": "npm install @capacitor/core @capacitor/cli @capacitor/android @capacitor/ios",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:android": "cd android && ./gradlew assembleDebug",
    "build:ios": "cd ios && pod install && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug"
  },
  "dependencies": {
    "@capacitor/core": "^5.5.0",
    "@capacitor/cli": "^5.5.0",
    "@capacitor/android": "^5.5.0",
    "@capacitor/ios": "^5.5.0",
    "@capacitor/splash-screen": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/secure-storage": "^0.1.0"
  },
  "devDependencies": {
    "@capacitor/app": "^5.0.6"
  }
}
