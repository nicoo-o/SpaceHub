{
  "name": "spacehub-desktop",
  "version": "1.0.0",
  "description": "SpaceHub Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.spacehub.app",
    "productName": "SpaceHub",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "../dist/**/*",
      "../logo.png"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../logo.png"
    },
    "mac": {
      "target": ["dmg", "pkg"],
      "icon": "../logo.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "../logo.png",
      "category": "Video"
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
